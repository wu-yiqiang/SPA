<Window x:Class="spa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:spa.Controls"
        Title="SPA"
        WindowStartupLocation="CenterScreen"
        Height="500"
        Width="900">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Grid Margin="14 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding ReceiveText}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="120" />
                                <ColumnDefinition  Width="120" />
                                <ColumnDefinition />
                                <ColumnDefinition  Width="60" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="显示时间戳" />
                            <CheckBox Grid.Column="1"
                                      Content="自动滚动" />
                            <local:DropdownLabel Grid.Column="2"
                                                 Label="编码"
                                                 ItemsSource="{Binding EncodeModeOptions}"
                                                 SelectedValue="{Binding SelectedReciveEncodeId}" />
                            <Button HorizontalAlignment="Right"
                                    Grid.Column="4"
                                    Content="清空" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1"  Margin="0 0 0 10">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding SendText}"
                                 AcceptsReturn="True"
                                 Margin="0 0 0 10" />
                        <Grid Grid.Row="1"
                               >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="自动发送" />
                            <Label Grid.Column="1" VerticalAlignment="Center" Content="发送周期(ms)" />
                            <TextBox Grid.Column="2"
                                     InputMethod.IsInputMethodEnabled="False"
                                    />
                            <local:DropdownLabel Grid.Column="3"
                                                 Label="编码"
                                                 ItemsSource="{Binding EncodeModeOptions}"
                                                 SelectedValue="{Binding SelectedReciveEncodeId}" />
                            <Button Grid.Column="4" HorizontalAlignment="Right" Grid.Row="0"
                                    Content="发送"
                                    Style="{DynamicResource AccentButtonStyle}" />
                            <Button Grid.Column="5" HorizontalAlignment="Right" Grid.Row="1"
                                    Content="清空" />
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
            <DockPanel  Grid.Column="1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>
                        <local:DropdownLabel  Grid.Row="0"
                                              Label="串口号"
                                              ItemsSource="{Binding SerialOptions}"
                                              SelectedValue="{Binding SelectedSerialId}" />
                        <local:DropdownLabel  Grid.Row="1"
                                              Label="波特率"
                                              ItemsSource="{Binding BaudRateOptions}"
                                              SelectedValue="{Binding SelectedBaudRateId}" />
                        <local:DropdownLabel  Grid.Row="2"
                                              Label="校验位"
                                              ItemsSource="{Binding BaudParityBitOptions}"
                                              SelectedValue="{Binding SelectedParityBitId}" />
                        <local:DropdownLabel  Grid.Row="3"
                                              Label="数据位"
                                              ItemsSource="{Binding BaudDataBitOptions}"
                                              SelectedValue="{Binding SelectedDataBitId}" />
                        <local:DropdownLabel  Grid.Row="4"
                                              Label="停止位"
                                              ItemsSource="{Binding BaudStopBitOptions}"
                                              SelectedValue="{Binding SelectedStopBitId}" />
                        
                    </Grid>
                    <Button Grid.Row="1"
                            Visibility="{Binding OpenSerial}"
                            Width="220"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="打开串口"  Click="Handle_Open"/>
                    <Button Grid.Row="1"
                            Width="220"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="关闭串口"
                            Click="Handle_Close" />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
